{
  "name": "bd-word",
  "version": "1.0.0",
  "private": true,
  "description": "Eigenständiger Word-inspirierter Offline-Texteditor für die Hochschuldemo",
  "author": "B&D Word Projekt",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "playwright test",
    "dist:win": "npm run build && electron-builder --win zip nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 --publish never",
    "analyze": "node scripts/analyze-rea.mjs"
  },
  "dependencies": {
    "@tiptap/extension-character-count": "^3.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "docx": "^9.0.0",
    "dompurify": "^3.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "pe-library": "^2.0.1",
    "png-to-ico": "^3.0.0",
    "resedit": "^3.1.0",
    "sharp": "^0.34.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "de.bd.word",
    "productName": "B&D Word",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "script": "scripts/installer.nsi",
      "oneClick": false,
      "createDesktopShortcut": true,
      "shortcutName": "B&D Word",
      "installerLanguages": [
        "de_DE"
      ]
    },
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "afterPack": "scripts/brand-windows.cjs",
    "extraFiles": [
      {
        "from": "assets/demo-bild.png",
        "to": "Demo/demo-bild.png"
      },
      {
        "from": "docs/LIVE_DEMO.md",
        "to": "Demo/LIVE_DEMO.md"
      },
      {
        "from": "docs/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ]
  }
}